# Copy this file to .env and fill in real values.
# Never commit .env. The database key and Discord token are secrets.


# Required.
# Bot token from the Discord Developer Portal.
DISCORD_TOKEN=


# Prefix for !ping and !info, and for custom commands.
# Default: !
BOT_PREFIX=!


# Optional.
#
# One or more comma-separated Discord server IDs.
#
# Despite the singular variable name, multiple guild IDs are supported:
#
# TEST_GUILD_ID=111111111111111111,222222222222222222
#
# When this is set:
# - slash commands are synced only to these guilds
# - previously registered global slash commands are cleared
# - the bot leaves guilds not listed here
#
# Guild command updates normally appear much faster than global commands.
#
# Leave this empty to use normal global slash-command sync instead.
TEST_GUILD_ID=


# Required.
# Exactly 64 hexadecimal characters.
#
# Generate one with:
#
# python -c "import secrets; print(secrets.token_hex(32))"
#
# Losing this key makes the database unreadable.
# Keep a copy somewhere other than the server.
# Treat a backup that includes .env as secret.
TFSBOT_DATABASE_KEY=


# Encrypted SQLCipher file.
# Default: data/tfsbot.sqlite3
APPLICATION_DB_PATH=data/tfsbot.sqlite3


# Optional.
# Discord user IDs that are always treated as owner.
# Comma-separated.
# Blank entries are ignored.
BOT_DEV_USER_IDS=


# ---------------------------------------------------------------------------
# Web UI
# ---------------------------------------------------------------------------

# Off unless explicitly enabled.
WEBUI_ENABLED=false

# Default bind is this machine only.
WEBUI_HOST=127.0.0.1

# Web UI HTTP port.
WEBUI_PORT=5050


# ---------------------------------------------------------------------------
# Password login
# ---------------------------------------------------------------------------

# Password login can be used alongside Discord OAuth.
#
# Only accounts 1 and 2 are read.
#
# If a username is configured, its password must also be configured.
# If a password is configured, its username must also be configured.
#
# Password login is required when the Web UI is enabled and Discord login
# is disabled.
WEBUI_PASSWORD_LOGIN_ENABLED=true

WEBUI_USER_1_USERNAME=
WEBUI_USER_1_PASSWORD=

WEBUI_USER_2_USERNAME=
WEBUI_USER_2_PASSWORD=


# ---------------------------------------------------------------------------
# Discord Web UI login
# ---------------------------------------------------------------------------

# Optional.
#
# When enabled, all four settings below are required.
#
# DISCORD_OAUTH_REDIRECT_URI must match the callback URL configured in the
# Discord Developer Portal exactly.
WEBUI_AUTH_DISCORD_ENABLED=false

DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=
DISCORD_OAUTH_REDIRECT_URI=
WEBUI_DISCORD_GUILD_ID=


# ---------------------------------------------------------------------------
# Discord Web UI role access
# ---------------------------------------------------------------------------

# Comma-separated Discord role IDs.
#
# Used until the Permissions page stores a role list for that server.
#
# An empty stored list falls back to these values.
#
# Owner matching wins over viewer matching.
WEBUI_DISCORD_ALLOWED_ROLE_IDS=
WEBUI_DISCORD_OWNER_ROLE_IDS=
WEBUI_DISCORD_VIEWER_ROLE_IDS=