# Copy this file to .env and fill in real values.
# Never commit .env. The database key and the Discord token are secrets.

# Required. Bot token from the Discord Developer Portal.
DISCORD_TOKEN=

# Prefix for !ping and !info, and for custom commands. Default: !
BOT_PREFIX=!

# Optional. When set, slash commands sync to this server only,
# which is much faster than a global sync. Leave empty in production
# unless you intend to publish commands to one server.
TEST_GUILD_ID=

# Required. Exactly 64 hexadecimal characters.
# Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Losing this key makes the database unreadable. Keep a copy somewhere
# other than the server, and treat a backup that includes .env as secret.
TFSBOT_DATABASE_KEY=

# Encrypted SQLCipher file. Default: data/tfsbot.sqlite3
APPLICATION_DB_PATH=data/tfsbot.sqlite3

# Optional. Discord user IDs that are always treated as owner.
# Comma-separated. Blank entries are ignored.
BOT_DEV_USER_IDS=

# Web UI. Off unless this is true. Default bind is this machine only.
WEBUI_ENABLED=false
WEBUI_HOST=127.0.0.1
WEBUI_PORT=5050

# Password login. Only accounts 1 and 2 are read.
# If you set a username you must set its password, and the other way round.
# Required when the Web UI is on and Discord login is off.
WEBUI_PASSWORD_LOGIN_ENABLED=true
WEBUI_USER_1_USERNAME=
WEBUI_USER_1_PASSWORD=
WEBUI_USER_2_USERNAME=
WEBUI_USER_2_PASSWORD=

# Discord login. Optional. When enabled, all four settings below are required.
# The redirect URI must match the Developer Portal exactly.
WEBUI_AUTH_DISCORD_ENABLED=false
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=
DISCORD_OAUTH_REDIRECT_URI=
WEBUI_DISCORD_GUILD_ID=

# Comma-separated role IDs. Used until the Permissions page stores a list
# for that server. An empty stored list falls back to these values.
# Owner matching wins over viewer matching.
WEBUI_DISCORD_ALLOWED_ROLE_IDS=
WEBUI_DISCORD_OWNER_ROLE_IDS=
WEBUI_DISCORD_VIEWER_ROLE_IDS=
